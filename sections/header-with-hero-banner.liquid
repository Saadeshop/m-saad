{{ 'header-with-hero-banner.css' | asset_url | stylesheet_tag: preload: true }}

{% liquid
  assign logo = section.settings.logo
  assign text = section.settings.text
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
%}

<div class="section">
    {% if logo !=blank %}
    <a class="hero-header-logo">
        {{-
            logo
            | image_url: width: 150
            | image_tag:
                width: logo.width,
                widths: '150, 352, 832, 1200, 1600, 1920, 2560, 3840',
                height: logo.height,
                alt: shop.name,
                sizes: '(min-width: 750px) calc(var(--logo-width)), 100vw'
        -}}
    </a>
    {% endif %}
    {% if text !=blank %}
    <div class="hero-header-content">
        {{ text }}
    </div>
    {% endif %}
    {% if button_label !=blank %}
    <a {% if button_link %}href="{{ button_link }}"{% endif %} class="hero-header-button">
        {{ button_label }}
    </a>
    {% endif %}
</div>

{% schema %}
{
  "name": "Header with Hero Banner",
  "class": "header-hero-section",
  "settings": [
    {
        "type": "header",
        "content": "Header"
    },
    {
      "type": "image_picker",
      "label": "Logo",
      "id": "logo"
    },
    {
      "type": "text",
      "label": "Text",
      "id": "text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "label": "Button label",
      "id": "button_label",
      "default": "Choose Gift"
    },
    {
      "type": "text",
      "label": "Button link",
      "id": "button_link"
    }
  ],
  "presets": [
    {
      "name": "Header with Hero Banner",
      "category": "Banners"
    }
  ]
}
{% endschema %}
