{% comment %} Header with Hero Banner {% endcomment %}
{{ 'header-with-hero-banner.css' | asset_url | stylesheet_tag: preload: true }}

{% comment %} HTML Markup {% endcomment %}
{% for block in section.blocks %}
    {% if block.type == 'header' %}

        {% liquid
            assign logo = block.settings.logo
            assign text = block.settings.text
            assign button_label = block.settings.button_label
            assign button_link = block.settings.button_link
            assign header_bg = block.settings.header_bg
        %}

         {% style %}
            #shopify-block-{{ block.id }} {
                background: {{ header_bg }};
            }
        {% endstyle %}

        <div class="section" id="shopify-block-{{ block.id }}">
            <div class="header-section">
                {% if logo !=blank %}
                <a href="/" class="hero-header-logo">
                    {{-
                        logo
                        | image_url: width: 600
                        | image_tag:
                            width: logo.width,
                            widths: '240, 352, 832, 1200, 1600, 1920, 2560, 3840',
                            height: logo.height,
                            alt: shop.name,
                            sizes: '(min-width: 750px) calc(var(--logo-width)), 100vw'
                    -}}
                </a>
                {% endif %}
                {% if text !=blank %}
                <div class="hero-header-content">
                    {{ text }}
                </div>
                {% endif %}
                {% if button_label !=blank %}
                <div class="hero-header-button">
                    <a {% if button_link %}href="{{ button_link }}"{% endif %}>
                        <span>{{ button_label }} {% render 'icon-arrow-right' %}</span>
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    
    {% elsif block.type == 'banner' %}
        <div class="header-hero__banner" id="shopify-block-{{ block.id }}">
            {% liquid
              assign image_desktop = block.settings.image_desktop
              assign image_mobile = block.settings.image_mobile
              assign heading = block.settings.heading
              assign subheading = block.settings.subheading
              assign heading_m = block.settings.heading_m
              assign subheading_m = block.settings.subheading_m
              assign heading_color = block.settings.heading_color
              assign subheading_color = block.settings.subheading_color
              assign button_label = block.settings.button_label
              assign button_link = block.settings.button_link
            %}

            {% style %}
            #shopify-block-{{ block.id }} .hero-banner__content h2,
            #shopify-block-{{ block.id }} .header-hero__content-mobile h2{
                color: {{ heading_color }};
            }
            #shopify-block-{{ block.id }} .hero-banner__content .rte,
            #shopify-block-{{ block.id }} .header-hero__content-mobile .rte{
                color: {{ subheading_color }};
            }
            {% endstyle %}

            <div class="header-hero__content-mobile is-hidden-desktop-only">
                {% if heading_m !=blank %}
                    <h2>{{ heading_m }}</h2>
                {% endif %}

                {% if subheading_m !=blank %}
                <div class="rte">{{ subheading_m }}</div>
                {% endif %}
            </div>

            {% if image_desktop !=blank %}
            <div class="hero-banner__image">
                <div class="hero-banner__desktop{% if image_mobile !=blank %} is-hidden-mobile-only{% endif %}">
                    {{-
                        image_desktop
                        | image_url: width: 3840
                        | image_tag:
                            width: image_desktop.width,
                            widths: '240, 352, 832, 1200, 1600, 1920, 2560, 3840',
                            height: image_desktop.height,
                            alt: image_desktop.alt,
                            sizes: '(min-width: 750px) calc(var(--logo-width)), 100vw'
                    -}}
                </div>
                {% if image_mobile !=blank %}
                <div class="hero-banner__mobile">
                    {{-
                        image_mobile
                        | image_url: width: 3840
                        | image_tag:
                            width: image_mobile.width,
                            widths: '240, 352, 832, 1200, 1600, 1920, 2560, 3840',
                            height: image_mobile.height,
                            alt: image_mobile.alt,
                            sizes: '(min-width: 750px) calc(var(--logo-width)), 100vw'
                    -}}
                </div>
                {% endif %}
            </div>
            <div class="hero-banner__content section">
                <div class="hero-banner__content-wrapper">
                    {% if heading !=blank %}
                        <h2 {% if heading_m !=blank %}class="is-hidden-mobile-only"{% endif %}>{{ heading }}</h2>
                    {% endif %}

                    {% if subheading !=blank %}
                    <div class="rte{% if subheading_m !=blank %} is-hidden-mobile-only{% endif %}">{{ subheading }}</div>
                    {% endif %}

                    {% if button_label !=blank %}
                    <div class="hero-header-button secondary--btn">
                        <a {% if button_link %}href="{{ button_link }}"{% endif %}>
                            <span>{{ button_label }} {% render 'icon-arrow-right' %}</span>
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endif %}
        </div>

    {% elsif block.type == 'bottom_bar' %}
        {% liquid
            assign content = block.settings.content
            assign content_m = block.settings.content_m
            assign content_color = block.settings.content_color
            assign content_bg = block.settings.content_bg
         %}

         {% style %}
            #shopify-block-{{ block.id }} {
                color: {{ content_color }};
                background: {{ content_bg }};
            }
         {% endstyle %}

        {% if content !=blank %}
        <div class="header-hero__bottom-bar section" id="shopify-block-{{ block.id }}">
            <div class="header-bottom__content{% if content_m !=blank %} is-hidden-mobile-only{% endif %}">
                {{ content }}
            </div>
            {% if content_m !=blank %}
                <div class="header-bottom__content is-hidden-desktop-only">
                    {{ content_m }}
                </div>
            {% endif %}
        </div>
        {% endif %}
    {% endif %}
{% endfor %}

{% schema %}
{
  "name": "Header with Hero Banner",
  "class": "header-hero-section",
  "max_blocks": 3,
  "settings": [
    
  ],
  "blocks": [
    {
        "name": "Header",
        "type": "header",
        "settings": [
            {
                "type": "image_picker",
                "label": "Logo",
                "id": "logo"
            },
            {
                "type": "text",
                "label": "Text",
                "id": "text",
                "default": "Find the ideal gift for your loved ones."
            },
            {
                "type": "text",
                "label": "Button label",
                "id": "button_label",
                "default": "Choose Gift"
            },
            {
                "type": "url",
                "label": "Button link",
                "id": "button_link"
            },
            {
                "type": "header",
                "content": "Colors"
            },
            {
                "type": "color_background",
                "label": "Background",
                "id": "header_bg",
                "default": "#F5F5F5"
            }
        ]
    },
    {
        "name": "Banner",
        "type": "banner",
        "settings": [
            {
                "type": "image_picker",
                "label": "Image (Desktop)",
                "id": "image_desktop"
            },
            {
                "type": "image_picker",
                "label": "Image (Mobile)",
                "id": "image_mobile"
            },
            {
                "type": "text",
                "label": "Heading (Desktop)",
                "id": "heading",
                "default": "The Gift Guide"
            },
            {
                "type": "richtext",
                "label": "Subheading (Desktop)",
                "id": "subheading",
                "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
            },
            {
                "type": "text",
                "label": "Heading (Mobile)",
                "id": "heading_m",
                "default": "The Gift Guide"
            },
            {
                "type": "richtext",
                "label": "Subheading (Mobile)",
                "id": "subheading_m",
                "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p>"
            },
            {
                "type": "text",
                "label": "Button label",
                "id": "button_label",
                "default": "Shop Now"
            },
            {
                "type": "url",
                "label": "Button link",
                "id": "button_link"
            },
            {
                "type": "header",
                "content": "Colors"
            },
            {
                "type": "color",
                "label": "Heading",
                "id": "heading_color",
                "default": "#000"
            },
            {
                "type": "color",
                "label": "Subheading",
                "id": "subheading_color",
                "default": "#000"
            }
        ]
    },
    {
        "name": "Bottom Bar",
        "type": "bottom_bar",
        "settings": [
            {
                "type": "richtext",
                "label": "Content (Desktop)",
                "id": "content",
                "default": "<p>SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL</p>"
            },
            {
                "type": "richtext",
                "label": "Content (Mobile)",
                "id": "content_m",
                "default": "<p>SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR</p>"
            },
            {
                "type": "header",
                "content": "Colors"
            },
            {
                "type": "color",
                "label": "Text",
                "id": "content_color",
                "default": "#000"
            },
            {
                "type": "color_background",
                "label": "Background",
                "id": "content_bg",
                "default": "#F5F5F5"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Header with Hero Banner",
      "category": "Banners"
    }
  ]
}
{% endschema %}
