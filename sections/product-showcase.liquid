{% comment %} Product Showcase {% endcomment %}
 {{ 'product-showcase.css' | asset_url | stylesheet_tag: preload: true }}

<div class="section">
    <div class="product-grid-showcase">
        {% for block in section.blocks %}
            {% liquid
            assign product = block.settings.product
            assign dot = block.settings.dot
            %}

            {% if product !=blank %}
                <div class="product-card">
                    <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>

{% schema %}
{
  "name": "Product Showcase",
  "class": "product-showcase-section",
  "max_blocks": 6,
  "settings": [
    {
        "type": "product",
        "label": "Automatically add product",
        "id": "auto_add_product",
        "info": "This product will be added automatically when any product with variant options Black and Medium is added"
    }
  ],
  "blocks": [
    {
        "name": "Product",
        "type": "product",
        "settings": [
            {
                "type": "product",
                "label": "Select product",
                "id": "product"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Product Showcase",
      "category": "Products"
    }
  ]
}
{% endschema %}
