

{% schema %}
{
  "name": "Product Showcase",
  "class": "product-showcase-section",
  "max_blocks": 6,
  "settings": [
    
  ],
  "blocks": [
    {
        "name": "Header",
        "type": "header",
        "settings": [
            {
                "type": "product",
                "label": "Automatically add product",
                "id": "auto_add_product",
                "info": "This product will be added automatically when any product with variant options Black and Medium is added"
            },
            {
                "type": "text",
                "label": "Text",
                "id": "text",
                "default": "Find the ideal gift for your loved ones."
            },
            {
                "type": "text",
                "label": "Button label",
                "id": "button_label",
                "default": "Choose Gift"
            },
            {
                "type": "url",
                "label": "Button link",
                "id": "button_link"
            },
            {
                "type": "header",
                "content": "Colors"
            },
            {
                "type": "color_background",
                "label": "Background",
                "id": "header_bg",
                "default": "#F5F5F5"
            }
        ]
    },
    {
        "name": "Banner",
        "type": "banner",
        "settings": [
            {
                "type": "image_picker",
                "label": "Image (Desktop)",
                "id": "image_desktop"
            },
            {
                "type": "text",
                "label": "Heading",
                "id": "heading",
                "default": "The Gift Guide"
            },
            {
                "type": "richtext",
                "label": "Subheading",
                "id": "subheading",
                "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
            },
            {
                "type": "text",
                "label": "Button label",
                "id": "button_label",
                "default": "Shop Now"
            },
            {
                "type": "url",
                "label": "Button link",
                "id": "button_link"
            }
        ]
    },
    {
        "name": "Bottom Bar",
        "type": "bottom_bar",
        "settings": [
            {
                "type": "richtext",
                "label": "Content",
                "id": "content",
                "default": "<p>SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL</p>"
            },
            {
                "type": "header",
                "content": "Colors"
            },
            {
                "type": "color_background",
                "label": "Background",
                "id": "content_bg",
                "default": "#F5F5F5"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Product Showcase",
      "category": "Products"
    }
  ]
}
{% endschema %}
