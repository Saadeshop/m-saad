{% comment %} Product Showcase {% endcomment %}
 {{ 'product-showcase.css' | asset_url | stylesheet_tag: preload: true }}

 {% liquid
   assign auto_add_product = section.settings.auto_add_product
   assign title = section.settings.title
 %}

{% if title !=blank %}
<div class="section">
    <h2 class="product-showcase-title">{{ title }}</h2>
</div>
{% endif %}

<div class="section">
    <div class="product-grid-showcase">
        {% for block in section.blocks %}
            {% liquid
            assign product = block.settings.product
            assign top = block.settings.top
            assign left = block.settings.left
            %}

            {% if product !=blank %}
                <div class="product-showcase-card">

                    {% style %}
                    .popup-dot-{{ block.id }}{
                        position: absolute;
                        top: {{ top }}%;
                        left: {{ left }}%;
                        transform: translate(-{{ left }}%, -{{ top }}%);
                    }
                    {% endstyle %}

                    <div class="popup-image-wrapper">
                        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
                        <span class="popup-dot-{{ block.id }}" data-popup="popup-{{ block.id }}">{% render 'icon-plus' %}</span>
                    </div>
                </div>

                <div class="popup-overlay" id="popup-{{ block.id }}">
                    <div class="popup">
                        <button class="close" type="button" data-close-popup>
                            {% render 'icon-close' %}
                        </button>
                        <div class="popup-content">
                            <div class="popup-image">
                            {% if product.featured_image %}
                                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
                            {% endif %}

                            <div class="popup-info">
                                <h3>{{ product.title }}</h3>
                                <p class="price">{{ product.price | money }}</p>

                                <div class="popup-description">
                                    {{ product.description }}
                                </div>
                            </div>
                            </div>

                            <div class="popup-details">
                                {% for option in product.options_with_values %}
                                    <div class="product-option is-{{ option.name | handleize }}" data-option-position="{{ option.position }}">
                                        <label>{{ option.name }}</label>

                                        {% if option.name == 'Size' or option.name == 'size' %}
                                            <div class="custom-select">
                                                <button type="button" class="custom-select-toggle">
                                                    <span>Choose your {{ option.name }}</span>
                                                    <span class="custom-toggle-icon">{% render 'icon-caret-down' %}</span>
                                                </button>

                                                <div class="custom-select-menu">
                                                    {% for value in option.values %}
                                                        <button type="button" class="custom-select-option" data-option-value="{{ value | escape }}">
                                                            {{ value }}
                                                        </button>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% else %}
                                            <div class="option-values">
                                                {% for value in option.values %}
                                                    <button type="button" class="option-value" data-option-value="{{ value | escape }}">
                                                        <span style="background: {{ value }};"></span>{{ value }}
                                                    </button>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endfor %}

                                <form class="popup-form">
                                    <input type="hidden" name="id" value="">

                                    <button type="button" class="popup-atc">
                                        <span class="atc-text">ADD TO CART {% render 'icon-arrow-right' %}</span>
                                        <span class="atc-spinner"></span>
                                    </button>

                                    <div class="variant-message"></div>
                                </form>
                            </div>
                        </div>

                        <script type="application/json" class="product-variants">
                            {{ product.variants | json }}
                        </script>

                        {% if auto_add_product !=blank %}
                            <script type="application/json" class="auto-add-product">
                                {
                                    "id": {{ auto_add_product.selected_or_first_available_variant.id }},
                                    "title": {{ auto_add_product.title | json }}
                                }
                            </script>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>

<script src="{{ 'product-showcase.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Product Showcase",
  "class": "product-showcase-section",
  "max_blocks": 6,
  "settings": [
    {
        "type": "text",
        "label": "Title",
        "id": "title",
        "default": "Tisso vison in the wild"
    },
    {
        "type": "product",
        "label": "Automatically add product",
        "id": "auto_add_product",
        "info": "This product will be added automatically when any product with variant options Black and Medium is added"
    }
  ],
  "blocks": [
    {
        "name": "Product",
        "type": "product",
        "settings": [
            {
                "type": "product",
                "label": "Select product",
                "id": "product"
            },
            {
                "type": "header",
                "content": "Dot Position"
            },
            {
                "type": "range",
                "label": "Top (%)",
                "id": "top",
                "min": 0,
                "max": 100,
                "default": 50,
                "step": 1
            },
            {
                "type": "range",
                "label": "Left (%)",
                "id": "left",
                "min": 0,
                "max": 100,
                "default": 50,
                "step": 1
            } 
        ]
    }
  ],
  "presets": [
    {
      "name": "Product Showcase",
      "category": "Products"
    }
  ]
}
{% endschema %}
