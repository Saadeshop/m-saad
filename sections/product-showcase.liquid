{% comment %} Product Showcase {% endcomment %}
 {{ 'product-showcase.css' | asset_url | stylesheet_tag: preload: true }}

<div class="section">
    <div class="product-grid-showcase">
        {% for block in section.blocks %}
            {% liquid
            assign product = block.settings.product
            assign dot = block.settings.dot
            %}

            {% if product !=blank %}
                <div class="product-showcase-card" data-popup="popup-{{ block.id }}">
                    <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
                </div>

                <div class="popup-overlay" id="popup-{{ block.id }}">
                    <div class="popup">
                        <button class="close" type="button" data-close-popup>
                            {% render 'icon-close' %}
                        </button>
                        <div class="popup-content">
                            {% if product.featured_image %}
                                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
                            {% endif %}

                            <div class="popup-details">
                                <h3>{{ product.title }}</h3>
                                <p class="price">{{ product.price | money }}</p>

                                <div class="popup-description">
                                    {{ product.description }}
                                </div>

                                {% for option in product.options_with_values %}
                                    <div class="product-option" data-option-position="{{ option.position }}">
                                        <label>{{ option.name }}</label>

                                        {% if option.name == 'Size' or option.name == 'size' %}
                                            <div class="custom-select">
                                                <button type="button" class="custom-select-toggle">
                                                    <span>Select {{ option.name }}</span>
                                                    <span>{% render 'icon-caret-down' %}</span>
                                                </button>

                                                <div class="custom-select-menu">
                                                    {% for value in option.values %}
                                                        <button type="button" class="custom-select-option" data-option-value="{{ value | escape }}">
                                                            {{ value }}
                                                        </button>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% else %}
                                            <div class="option-values">
                                                {% for value in option.values %}
                                                    <button type="button" class="option-value" data-option-value="{{ value | escape }}">
                                                        {{ value }}
                                                    </button>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>

{% schema %}
{
  "name": "Product Showcase",
  "class": "product-showcase-section",
  "max_blocks": 6,
  "settings": [
    {
        "type": "product",
        "label": "Automatically add product",
        "id": "auto_add_product",
        "info": "This product will be added automatically when any product with variant options Black and Medium is added"
    }
  ],
  "blocks": [
    {
        "name": "Product",
        "type": "product",
        "settings": [
            {
                "type": "product",
                "label": "Select product",
                "id": "product"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Product Showcase",
      "category": "Products"
    }
  ]
}
{% endschema %}
